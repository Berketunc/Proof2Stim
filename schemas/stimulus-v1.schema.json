{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof2stim.dev/schemas/stimulus-v1.schema.json",
  "title": "Proof2Stim normalized stimulus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "input_signals", "cycles"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_id", "target_id", "target_spec_sha256", "rtl_commit", "rtl_sha256", "formal_depth", "solver", "source_witness_sha256", "unknown_policy", "reset_steps_omitted"],
      "properties": {
        "benchmark_id": {"type": "string"},
        "target_id": {"type": "string"},
        "target_spec_sha256": {"$ref": "#/$defs/hash"},
        "rtl_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rtl_sha256": {"$ref": "#/$defs/hash"},
        "formal_depth": {"type": "integer", "minimum": 1},
        "solver": {"type": "string", "minLength": 1},
        "source_witness_sha256": {"$ref": "#/$defs/hash"},
        "unknown_policy": {"const": "zero_fill_preserve_mask"},
        "reset_steps_omitted": {"type": "integer", "minimum": 0}
      }
    },
    "input_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "width"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"},
          "width": {"type": "integer", "minimum": 1}
        }
      }
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cycle", "assignments"],
        "properties": {
          "cycle": {"type": "integer", "minimum": 0},
          "assignments": {
            "type": "object",
            "additionalProperties": {"$ref": "#/$defs/value"}
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "known_mask"],
      "properties": {
        "value": {"type": "string", "pattern": "^0x[0-9a-f]+$"},
        "known_mask": {"type": "string", "pattern": "^0x[0-9a-f]+$"}
      }
    }
  }
}
