{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof2stim.dev/schemas/pipeline-run-v1.schema.json",
  "title": "Proof2Stim pipeline run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "benchmark_id",
    "target_id",
    "started_utc",
    "finished_utc",
    "duration_seconds",
    "exit_status",
    "status",
    "accepted",
    "cache_enabled",
    "git",
    "environment",
    "configuration",
    "upstream",
    "target_specification",
    "preflight",
    "stages",
    "model_usage",
    "estimated_model_cost_usd"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "benchmark_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "started_utc": {"type": "string", "format": "date-time"},
    "finished_utc": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "exit_status": {"enum": [0, 1]},
    "status": {"enum": ["passed", "rejected", "failed"]},
    "accepted": {"type": "boolean"},
    "cache_enabled": {"type": "boolean"},
    "error": {"type": "string", "minLength": 1},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "machine"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation_seed", "formal", "versions_file", "versions_sha256"],
      "properties": {
        "simulation_seed": {"type": "integer", "minimum": 0},
        "formal": {"type": "object"},
        "versions_file": {"type": "string", "minLength": 1},
        "versions_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "license", "license_path", "license_sha256", "sources"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "minLength": 1},
        "license_path": {"type": "string", "minLength": 1},
        "license_sha256": {"$ref": "#/$defs/sha256"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "target_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "preflight": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "duration_seconds", "returncode"],
        "properties": {
          "command": {"$ref": "#/$defs/command"},
          "duration_seconds": {"type": "number", "minimum": 0},
          "returncode": {"type": "integer"}
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "cache_hit", "cache_key", "command", "duration_seconds", "returncode", "inputs", "outputs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "status": {"enum": ["passed", "failed"]},
          "cache_hit": {"type": "boolean"},
          "cache_key": {"$ref": "#/$defs/sha256"},
          "command": {"$ref": "#/$defs/command"},
          "duration_seconds": {"type": "number", "minimum": 0},
          "returncode": {"type": ["integer", "null"]},
          "inputs": {"$ref": "#/$defs/hashMap"},
          "outputs": {"$ref": "#/$defs/hashMap"}
        }
      }
    },
    "model_usage": {"type": "array", "items": {"type": "object"}},
    "estimated_model_cost_usd": {"type": "number", "minimum": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "hashMap": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
  }
}
