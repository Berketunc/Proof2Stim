{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof2stim.dev/schemas/model-proposal-run-v1.schema.json",
  "title": "Proof2Stim validated model proposal run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "benchmark_id", "target_id", "provider", "model", "project", "location", "prompt_version", "prompt_sha256", "response_schema_sha256", "started_utc", "finished_utc", "latency_seconds", "generation_config", "provider_controls", "usage", "pricing_usd_per_million_tokens", "estimated_cost_usd", "cost_cap_usd", "artifacts", "validation_checks", "final_acceptance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "validated_proposal"},
    "benchmark_id": {"$ref": "#/$defs/id"},
    "target_id": {"$ref": "#/$defs/id"},
    "provider": {"const": "google-vertex-ai"},
    "model": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "prompt_version": {"const": "target-harness-v1"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "response_schema_sha256": {"$ref": "#/$defs/sha256"},
    "started_utc": {"type": "string", "format": "date-time"},
    "finished_utc": {"type": "string", "format": "date-time"},
    "latency_seconds": {"type": "number", "minimum": 0},
    "generation_config": {"$ref": "#/$defs/generationConfig"},
    "provider_controls": {"$ref": "#/$defs/providerControls"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "thinking_tokens", "cached_input_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "thinking_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "pricing_usd_per_million_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {"type": "number", "minimum": 0},
        "output": {"type": "number", "minimum": 0}
      }
    },
    "estimated_cost_usd": {"type": "number", "minimum": 0},
    "cost_cap_usd": {"type": "number", "exclusiveMinimum": 0},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "request_sha256", "proposal", "proposal_sha256"],
      "properties": {
        "request": {"type": "string", "minLength": 1},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "proposal": {"type": "string", "minLength": 1},
        "proposal_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validation_checks": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["json_schema", "identity", "rtl_evidence", "signal_scope", "identifier_uniqueness", "acceptance_boundary"]}
    },
    "final_acceptance": {"const": "requires_formal_and_replay"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "top_p", "max_output_tokens", "response_mime_type"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 65536},
        "response_mime_type": {"const": "application/json"}
      }
    },
    "providerControls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "timeout_seconds", "max_attempts"],
      "properties": {
        "api_version": {"const": "v1"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "max_attempts": {"const": 1}
      }
    }
  }
}
