{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof2stim.dev/schemas/chia-run-v1.schema.json",
  "title": "Proof2Stim CHIA graph run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "target_id",
    "accepted",
    "started_utc",
    "finished_utc",
    "duration_seconds",
    "orchestrator",
    "profile_directory",
    "stages",
    "artifacts",
    "model_usage",
    "estimated_model_cost_usd"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "accepted": {"const": true},
    "started_utc": {"type": "string", "format": "date-time"},
    "finished_utc": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit", "ray_version"],
      "properties": {
        "name": {"const": "CHIA"},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "ray_version": {"type": "string", "minLength": 1}
      }
    },
    "profile_directory": {"type": ["string", "null"]},
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/stage"}
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_result", "acceptance_sha256"],
      "properties": {
        "acceptance_result": {"type": "string", "minLength": 1},
        "acceptance_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model_usage": {"type": "array", "maxItems": 0},
    "estimated_model_cost_usd": {"const": 0.0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashMap": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "cache_key", "command", "duration_seconds", "returncode", "inputs", "outputs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "status": {"const": "passed"},
        "cache_key": {"$ref": "#/$defs/sha256"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "duration_seconds": {"type": "number", "minimum": 0},
        "returncode": {"const": 0},
        "inputs": {"$ref": "#/$defs/hashMap"},
        "outputs": {"$ref": "#/$defs/hashMap"}
      }
    }
  }
}
